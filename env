DATABASE_URL=postgresql://facecat:facecat@127.0.0.1:5432/facecat

THUMBS_DIR=$PWD/thumbs

MODEL_NAME=buffalo_l
GPU_DEVICE_ID=0
DET_SIZE=640
MAX_DETECT_SIDE=1600

ALLOW_CPU_RESIZE=1

GROUP_K=20
GROUP_THRESHOLD=0.55
SEARCH_LIMIT=50

# --- multi-GPU indexing / grouping (defaults; CLI flags override) ---
THREADS_PER_GPU=4
INDEX_CPU_WORKERS=8
INDEX_DECODE_QUEUE=16
INDEX_GPU_QUEUE=8
GROUP_BLOCK_SIZE=512
KNN_CHUNK=0

# cuDNN 9 ships in the venv as a wheel (nvidia-cudnn-cu12); CUDA 12 runtime is
# system-wide. Both are needed by onnxruntime-gpu at import time, otherwise it
# silently falls back to CPU.
export LD_LIBRARY_PATH=$PWD/.v312/lib/python3.12/site-packages/nvidia/cudnn/lib:/usr/local/cuda-12/lib64:${LD_LIBRARY_PATH:-}

# This box has 3 GPUs (0: RTX 3090, 1: RTX 3080 Ti, 2: RTX 3090); 0 and 2 are
# usually busy with other work. Physical indices match the ids passed to ONNX
# Runtime. Override with FACECAT_GPUS (e.g. "0,1") or --gpus on the CLI.
export CUDA_VISIBLE_DEVICES=0,1
