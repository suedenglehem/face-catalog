# Environment for the Dockerized face catalog (loaded by docker-compose.yml).
# Values here are container-appropriate; the host `env` file is used only for
# running the app directly on the machine.

# Inside the compose network the DB service is reachable at hostname "db".
DATABASE_URL=postgresql://facecat:facecat@db:5432/facecat

# Thumbnails live in a named volume mounted at /data/thumbs.
THUMBS_DIR=/data/thumbs

MODEL_NAME=buffalo_l
GPU_DEVICE_ID=0
DET_SIZE=640
MAX_DETECT_SIDE=1600

ALLOW_CPU_RESIZE=1

GROUP_K=20
GROUP_THRESHOLD=0.55
SEARCH_LIMIT=50

# --- multi-GPU indexing / grouping (defaults; CLI flags override) ---
THREADS_PER_GPU=4
INDEX_CPU_WORKERS=8
INDEX_DECODE_QUEUE=16
INDEX_GPU_QUEUE=8
GROUP_BLOCK_SIZE=512
KNN_CHUNK=0

# Both GPUs visible to the container; physical indices match the ids passed to
# ONNX Runtime. Override with FACECAT_GPUS (e.g. "0,1") or --gpus on the CLI.
CUDA_VISIBLE_DEVICES=0,1